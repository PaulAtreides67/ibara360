# nm -n --defined-only output -> source/profsyms.c for source/prof.c (test 14b's second
# link pass). Text symbols (T t W w) in address order until the symbol ENDSYM (-v ENDSYM=...),
# which marks the end of .text (360: app.lds's elfldr_start; PC harness: etext).
# Plain awk (no strtonum): addresses stay hex strings, leading zeros dropped.
BEGIN { n = 0; off = 0 }
$3 == ENDSYM { done = 1 }
done { next }
NF == 3 && ($2 == "T" || $2 == "t" || $2 == "W" || $2 == "w") {
	a = $1
	sub(/^0+/, "", a)
	if (a == "")
		a = "0"
	addr[n] = "0x" a "u"
	name[n] = $3
	noff[n] = off
	off += length($3) + 1
	n++
}
END {
	print "/* generated by mksyms.awk from nm (second link pass): do not edit */"
	print "#include <stdint.h>"
	print ""
	print "const unsigned prof_nsyms = " n + 0 ";"
	print "const uint32_t prof_sym_addr[" (n ? n : 1) "] = {"
	for (i = 0; i < n; i++)
		print "\t" addr[i] ","
	if (!n)
		print "\t0"
	print "};"
	print "const uint32_t prof_sym_off[" (n ? n : 1) "] = {"
	for (i = 0; i < n; i++)
		print "\t" noff[i] ","
	if (!n)
		print "\t0"
	print "};"
	print "const char prof_sym_names[] ="
	for (i = 0; i < n; i++)
		print "\t\"" name[i] "\\000\""
	print "\t\"\";"
}
